<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../uss/InventoryWindow.uss"/>

<!-- Contenedor de todas las ventanas de inventario. Existen en el mismo UIDocument
     (y por tanto en el mismo panel) a proposito: paneles distintos no comparten arbol,
     asi que arrastrar un item de una ventana a otra seria imposible y la captura de
     puntero no cruzaria entre ellos. Huecos fijos, no ventanas libres. -->
<ui:VisualElement name="ui-root" class="ui-root">

    <ui:VisualElement name="inventory-root" class="inventory-root">

        <!-- Tabs de eleccion -->
        <ui:VisualElement name="left-tabs-bar" class="left-tabs-bar">
            <ui:VisualElement name="equipment-tab" class="left-tab equipment-related">
            
            </ui:VisualElement>
            <ui:VisualElement name="health-tab" class="left-tab health-related">
            
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Paneles principales: personal (izq) + inventario (dcha) -->
        <ui:VisualElement name="main-area" class="main-area">

            <!-- Barra de título para drag -->
            <ui:VisualElement name="title-bar" class="title-bar">
                <ui:Label name="title-label" text="Inventario" class="title-label"/>
                <ui:Button name="dev-catalog-button" text="DEV: Items Catalog" class="dev-button"/>
                <ui:Button name="close-button" text="✕" class="close-button"/>
            </ui:VisualElement>
            

            

            <ui:VisualElement name="content-area" class="content-area">
                <!-- Zona principal -->
                <ui:VisualElement name="player-panels" class="player-panels">
                    <!-- Panel personal: equipment + health placeholder -->
                    <ui:VisualElement name="left-panel" class="left-panel">
                        <ui:VisualElement name="health-panel" class="internal-personal-panel health-related">
                            <ui:VisualElement name="health-placeholder" class="health-placeholder">
                                <ui:Label text="Health" class="section-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="equipment-panel" class="internal-personal-panel equipment-panel equipment-related">
                            <ui:VisualElement name="equipment-cross" class="equipment-cross">
                                <!-- Cruz -->
                                <ui:VisualElement class="equip-row">
                                    <ui:VisualElement class="equip-spacer"/>
                                    <ui:VisualElement name="slot-head" class="equip-slot"/>
                                    <ui:VisualElement class="equip-spacer"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="equip-row">
                                    <ui:VisualElement name="slot-lefthand" class="equip-slot"/>
                                    <ui:VisualElement name="slot-chest" class="equip-slot"/>
                                    <ui:VisualElement name="slot-righthand" class="equip-slot"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="equip-row">
                                    <ui:VisualElement class="equip-spacer"/>
                                    <ui:VisualElement name="slot-legs" class="equip-slot"/>
                                    <ui:VisualElement class="equip-spacer"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="equip-row">
                                    <ui:VisualElement class="equip-spacer"/>
                                    <ui:VisualElement name="slot-feet" class="equip-slot"/>
                                    <ui:VisualElement class="equip-spacer"/>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Columna lateral -->
                            <ui:VisualElement class="equip-side">
                                <ui:VisualElement name="slot-back" class="equip-slot"/>
                                <ui:VisualElement name="slot-hip" class="equip-slot"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Panel inventario: weight bar + tetris grid -->
                    <ui:VisualElement name="inventory-panel" class="inventory-panel">
                        <!-- Carril de peso: fondo fijo. El relleno va en absoluto (su width es el
                             % de carga) y la etiqueta despues, para que se pinte encima sin
                             competir por el espacio ni verse recortada cuando el relleno es corto. -->
                        <ui:VisualElement name="weight-rail" class="weight-rail">
                            <ui:VisualElement name="weight-bar" class="weight-bar"/>
                            <ui:Label name="weight-label" text="0/0 kg" class="weight-label"/>
                        </ui:VisualElement>
                        <!-- Punto de montaje: GenerateGrid lo vacia y le mete la grid tetris.
                             Existe para poder hacer Clear() sin borrar el weight-rail hermano. -->
                        <ui:VisualElement name="grid-mount" class="grid-mount"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Franja inferior: info del item seleccionado -->
                <ui:VisualElement name="inspection-strip" class="inspection-strip">
                    <ui:VisualElement name="inspect-icon" class="inspect-icon"/>
                    <ui:VisualElement name="inspect-info" class="inspect-info">
                        <ui:Label name="inspect-name" class="inspect-name"/>
                        <ui:Label name="inspect-description" class="inspect-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="inspect-stats" class="inspect-stats">
                        <ui:Label name="inspect-weight" class="inspect-stat"/>
                        <ui:Label name="inspect-durability" class="inspect-stat"/>
                        <ui:Label name="inspect-size" class="inspect-stat"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="subslots-popup" class="subslots-popup">
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Hueco lateral A: puede alojar el catalogo de desarrollo o, desde M6, un
         contenedor externo (arcon, carro, NPC). Cada contenido es UN solo hijo,
         para que alternarlos o trasplantarlos a otro hueco sea trivial. -->
    <ui:VisualElement name="side-panel-a" class="side-panel">

        <ui:VisualElement name="item-catalog" class="panel-content">

            <ui:VisualElement name="catalog-title-bar" class="title-bar">
                <ui:Label text="Items Catalog" class="title-label"/>
                <ui:Button name="catalog-close-button" text="✕" class="close-button"/>
            </ui:VisualElement>

            <ui:TextField name="catalog-search" class="catalog-search"/>

            <ui:ScrollView name="catalog-scroll" class="catalog-scroll"/>

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Hueco lateral B: vacio hasta M6. Permite transferir entre dos contenedores
         externos sin pasar por el inventario del jugador. -->
    <ui:VisualElement name="side-panel-b" class="side-panel"/>

</ui:VisualElement>

<ui:VisualElement name="tooltip" class="tooltip"/>
</ui:UXML>
