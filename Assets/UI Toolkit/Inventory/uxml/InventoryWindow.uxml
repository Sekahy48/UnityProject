<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../uss/InventoryWindow.uss"/>
    <ui:VisualElement name="inventory-root" class="inventory-root">
        
        <!-- Barra de título para drag -->
        <ui:VisualElement name="title-bar" class="title-bar">
            <ui:Label name="title-label" text="Inventario" class="title-label"/>
            <ui:Button name="close-button" text="✕" class="close-button"/>
        </ui:VisualElement>

        <!-- Cuerpo principal -->
        <ui:VisualElement name="inventory-body" class="inventory-body">
            
            <!-- Panel izquierdo: tabs -->
            <ui:VisualElement name="tab-panel" class="tab-panel">
                <ui:ScrollView name="tab-scroll" class="tab-scroll">
                    <ui:VisualElement name="tab-list" class="tab-list"/>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Panel derecho: contenido -->
            <ui:VisualElement name="content-panel" class="content-panel">
                
                <!-- Cabecera con stats de peso/volumen -->
                <ui:VisualElement name="stats-bar" class="stats-bar">
                    <ui:Label name="weight-label" text="Peso: 0/0 kg" class="stat-label"/>
                    <ui:Label name="volume-label" text="Volumen: 0/0 L" class="stat-label"/>
                </ui:VisualElement>

                <!-- Grid de items -->
                <ui:ScrollView name="item-scroll" class="item-scroll">
                    <ui:VisualElement name="item-grid" class="item-grid"/>
                </ui:ScrollView>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>