.equipment-panel {
    flex-direction: row;
    flex-grow: 1;
    padding: 8px;
    align-items: flex-start;
}

/* ── Panel de silueta ── */
.body-panel {
    width: 120px;
    height: 60%;
    align-items: center;
    justify-content: flex-start;
    margin-right: 8px;
}

.body-image {
    width: 100px; 
    height: 60%;
    flex-grow: 1;
    background-color: rgba(30, 30, 30, 0.6);
    border-width: 1px;
    border-color: rgba(70, 70, 70, 0.6);
    border-radius: 4px;
}

/* ── Columna de slots ── */
.slots-column {
    flex-direction: column;
    flex-grow: 1;
    justify-content: flex-start;
}

.slot-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
}

/* ── Slot base ── */
.slot {
    width: 48px;
    height: 48px;
    margin: 3px;
    background-color: rgba(40, 40, 40, 0.9);
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.7);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    overflow: visible;
    position: relative;
}

.slot:hover {
    border-color: rgba(150, 150, 150, 0.9);
    background-color: rgba(55, 55, 55, 0.9);
}

.slot-icon {
    width: 36px;
    height: 36px;
}

/* ── Botón de expansión ── */
.slot-expand-btn {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 14px;
    height: 14px;
    font-size: 7px;
    background-color: rgba(60, 100, 60, 0.9);
    border-width: 0;
    border-radius: 2px;
    color: rgba(200, 200, 200, 1);
    padding: 0;
    cursor: pointer;
}

.slot-expand-btn:hover {
    background-color: rgba(80, 130, 80, 1);
}

/* ── Dropdown del slot ── */
.slot-dropdown {
    position: absolute;
    top: 50px;
    left: 0;
    width: 48px;
    flex-direction: column;
    background-color: rgba(25, 25, 25, 0.95);
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.7);
    border-radius: 4px;
    display: none;
    z-index: 100;
}

.slot-dropdown--visible {
    display: flex;
}

.slot-dropdown-item {
    width: 40px;
    height: 40px;
    margin: 4px auto;
    background-color: rgba(40, 40, 40, 0.9);
    border-width: 1px;
    border-color: rgba(70, 70, 70, 0.6);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

.slot-dropdown-item:hover {
    border-color: rgba(140, 140, 140, 0.8);
}