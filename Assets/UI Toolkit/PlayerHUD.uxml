<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/PlayerHUDStyle.uss?fileID=7433441132597879392&amp;guid=42e6b8024efe2e643b2a4333895bd259&amp;type=3#PlayerHUDStyle" />
    <Style src="Theme/ActiveTheme.uss" />
    <ui:VisualElement picking-mode="Ignore" name="hud-root" class="hud">
        <ui:VisualElement picking-mode="Ignore" name="hud-bars" class="hud__bars">
            <ui:VisualElement picking-mode="Ignore" name="fatigue-bar" class="hud-bar hud-bar--fatigue">
                <ui:VisualElement picking-mode="Ignore" name="fill" class="hud-bar__fill" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" name="stamina-bar" class="hud-bar hud-bar--stamina">
                <ui:VisualElement picking-mode="Ignore" name="fill" class="hud-bar__fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement picking-mode="Ignore" name="states-bar" class="hud__states"/>
        <ui:VisualElement picking-mode="Ignore" name="states-tooltip" class="tooltip hud__tooltip"/>
    </ui:VisualElement>
</ui:UXML>
