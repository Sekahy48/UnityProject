/* Panel de inspeccion suelto: estructura y colores neutros. El aspecto de tema lo pone
   la hoja del tema activo, igual que en el inventario. */

/* Capa a pantalla completa que centra el panel y no captura el raton fuera de el. */
.ip-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.inspect-panel {
    width: 460px;
    max-height: 70%;
    flex-direction: column;
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.8);
    border-radius: 6px;
}

/* Mismas medidas que la barra de titulo del inventario (InventoryWindow.uss no se carga
   aqui, asi que se repiten las que importan). */
.ip__title-bar {
    height: 32px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 6px;
    background-color: rgba(40, 40, 40, 1);
}

/* Doble clase en el mismo elemento (no anidado) para ganar al tema, como antes. */
.title-bar__label.ip__title {
    flex-grow: 1;
    font-size: 18px;
    color: rgba(200, 200, 200, 1);
    -unity-font-definition: url('../Inventory/fonts/AlegreyaSansSC-Regular SDF.asset');
}

.ip__close {
    width: 20px;
    height: 20px;
    border-width: 0;
    font-size: 11px;
}

.ip__body {
    flex-direction: column;
    flex-shrink: 1;
    padding: 12px 16px 10px 16px;
}

/* ---------- Cabecera: icono grande + quien es ---------- */

.ip__header {
    flex-direction: row;
}

.ip__icon {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background-color: rgba(40, 40, 40, 0.8);
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.6);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.ip__identity {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 12px;
    justify-content: center;
}

.ip__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(220, 220, 220, 1);
    -unity-font-definition: url('../Inventory/fonts/Vollkorn-Regular SDF.asset');
}

.ip__type {
    font-size: 13px;
    color: rgba(150, 150, 150, 1);
    margin-bottom: 4px;
    -unity-font-definition: url('../Inventory/fonts/AlegreyaSansSC-Regular SDF.asset');
}

.ip__description {
    font-size: 15px;
    white-space: normal;
    color: rgba(170, 170, 170, 1);
    -unity-font-definition: url('../Inventory/fonts/Vollkorn-Regular SDF.asset');
}

.ip__divider {
    height: 1px;
    margin: 10px 0;
    background-color: rgba(80, 80, 80, 0.8);
}

/* ---------- Tabla de datos: clave a la izquierda, valor a la derecha ---------- */

.ip__stats {
    flex-direction: column;
}

.ip-stat {
    flex-direction: row;
    justify-content: space-between;
    height: 24px;
    align-items: center;
    padding: 0 6px;
}

.ip-stat__key {
    font-size: 14px;
    color: rgba(150, 150, 150, 1);
    -unity-font-definition: url('../Inventory/fonts/AlegreyaSansSC-Regular SDF.asset');
}

.ip-stat__value {
    font-size: 15px;
    color: rgba(220, 220, 220, 1);
    -unity-font-definition: url('../Inventory/fonts/Vollkorn-Regular SDF.asset');
}

/* ---------- Desglose de variantes ---------- */

.ip__lots-section {
    flex-direction: column;
    flex-shrink: 1;
    margin-top: 10px;
}

.ip__section-label {
    font-size: 14px;
    color: rgba(150, 150, 150, 1);
    margin-bottom: 4px;
    -unity-font-definition: url('../Inventory/fonts/AlegreyaSansSC-Regular SDF.asset');
}

.ip__lots {
    max-height: 180px;
}

.ip-lot {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 6px;
    margin-bottom: 2px;
    background-color: rgba(40, 40, 40, 0.6);
}

.ip-lot__icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.ip-lot__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14px;
    color: rgba(210, 210, 210, 1);
    -unity-font-definition: url('../Inventory/fonts/Vollkorn-Regular SDF.asset');
}

.ip-lot__amount,
.ip-lot__weight {
    width: 60px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    font-size: 14px;
    color: rgba(190, 190, 190, 1);
    -unity-font-definition: url('../Inventory/fonts/Vollkorn-Regular SDF.asset');
}

.ip__footer {
    margin-top: 10px;
    -unity-text-align: middle-right;
    font-size: 12px;
    -unity-font-style: italic;
    color: rgba(130, 130, 130, 1);
}
