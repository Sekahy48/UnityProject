VisualElement {
}

/* Contenedor del HUD: ocupa la pantalla para que lo que se ancle a sus bordes (la futura
   columna de estados) tenga referencia. La vista lo oculta y lo muestra con display. */
.hudContainer {
    flex-grow: 1;
    flex-direction: row;
}

.barsContainer {
    flex-direction: column;
    
    flex-grow: 1;
}

.statesBar {
    flex-direction: column;
}

/* Relleno de una barra: tapa el carril entero y la vista solo cambia su ancho. El color
   va aqui y no en linea en el UXML, para que un tema pueda cambiarlo. */
.fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.fatigueBar .fill {
    background-color: rgb(200, 255, 0);
}

.staminaBar .fill {
    background-color: rgb(250, 255, 81);
}

.staminaBar {
    width: 300px;
    height: 18px;
    margin-top: 3px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    background-color: rgba(0, 0, 0, 0.86);
}

.fatigueBar {
    width: 450px;
    height: 18px;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 2px;
    margin-left: 25px;
    background-color: rgba(0, 0, 0, 0.86);
    visibility: visible;
    display: flex;
    overflow: visible;
}

/* Orbe de sangre: retirado del HUD de momento (sin elemento en PlayerHUD.uxml). Sus
   reglas se quedan para cuando vuelva con las heridas. */
.orbfill {
    background-image: resource('Images/descarga');
    border-bottom-left-radius: 50%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    margin-top: -10px;
    margin-right: -10px;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
    margin-bottom: 10px;
    margin-left: -10px;
    position: absolute;
    right: 10px;
    bottom: 10px;
}

.bloodOrb {
    width: 75px;
    height: 75px;
}

.emptyOrb {
    background-image: resource('Images/Empty_Orb');
    position: absolute;
    right: 0;
    bottom: 0;
    overflow: visible;
    width: 75px;
    height: 75px;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-repeat: no-repeat no-repeat;
    margin-top: -10px;
    margin-right: -10px;
    margin-bottom: 10px;
    margin-left: -10px;
}

/* ---------- Estados (columna a la derecha) ----------
   Un icono por categoria. La vista pone .status y la clase de su nivel
   (status--<categoria>-<nivel>, el nivel es el int del enum de niveles de esa categoria);
   la imagen la elige este fichero, asi que un tema puede cambiar los iconos sin tocar C#.
   El nivel 0 no tiene clase: es "sin estado" y el icono se quita. */

.status {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Peso: WeightLevel 1 = Extra, 2 = Over, 3 = Immobile. */
.status--weight-1 {
    background-image: url('HUD/images/status/ExtraWeight.png');
}

.status--weight-2 {
    background-image: url('HUD/images/status/Overweight.png');
}

.status--weight-3 {
    background-image: url('HUD/images/status/Immobile.png');
}
