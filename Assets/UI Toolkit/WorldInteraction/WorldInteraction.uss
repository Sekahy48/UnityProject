/* Capa de interaccion con el mundo: ocupa la pantalla y no captura el raton. */
.wi-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* La marca se coloca por codigo (left/top = punto proyectado). El translate la centra en
   horizontal y la sube entera por encima del punto, sin depender de lo largo del texto. */
.wi-prompt {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 6px;
    background-color: rgba(20, 16, 12, 0.72);
    border-radius: 4px;
}

.wi-row {
    flex-direction: row;
    align-items: center;
}

.wi-key {
    min-width: 22px;
    height: 22px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(30, 24, 18);
    background-color: rgb(232, 220, 196);
    border-radius: 3px;
}

.wi-action {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 232, 216);
}

.wi-target {
    font-size: 13px;
    color: rgb(200, 190, 170);
}

.wi-more {
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(160, 150, 132);
}

/* Punto de mira. Un rombo pequeno de laton con filo oscuro: se lee sobre cielo claro y sobre
   tierra oscura, y la forma de gema/remache encaja con una fantasia medieval sin ser un
   adorno que tape lo que apuntas. Sin objetivo es discreto; con objetivo se aviva y crece,
   que es lo que le dice al jugador que la E hara algo. */
.wi-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    rotate: 45deg;
    border-width: 1px;
    border-color: rgba(28, 20, 12, 0.85);
    background-color: rgba(196, 170, 120, 0.55);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

/* Brillo interior: un punto mas claro en el centro, como el reflejo de un remache. */
.wi-reticle-core {
    width: 3px;
    height: 3px;
    background-color: rgba(250, 238, 205, 0.7);
}

.wi-reticle--active {
    scale: 1.4 1.4;
    background-color: rgba(222, 180, 86, 0.95);
    border-color: rgba(40, 26, 10, 1);
}

.wi-reticle--hidden {
    display: none;
}
